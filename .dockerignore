__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.venv/
venv/
env/
models/

# Research and notebooks
archive/
research/
notebooks/
.ipynb_checkpoints/

# Tests & profiling
tests/
.coverage
htmlcov/
*benchmark*
scripts/profile_pipeline.py
scripts/benchmark_embeddings.py

